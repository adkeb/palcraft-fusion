* text=auto
*.sh text eol=lf
*.py text eol=lf
*.lua text eol=lf
*.java text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.swift text eol=lf
*.ps1 text eol=crlf
*.patch whitespace=-blank-at-eol,-blank-at-eof

player-standalone/full-mc-source/** -text
player-standalone/full-mc-source/packaged-resources/MANIFEST.MF whitespace=cr-at-eol,-blank-at-eof

# Preserve byte-pinned current build sources and resources across Git checkouts.
workstreams/current-mc10-10-source-build/** -text
workstreams/current-native33-source-build/** -text
workstreams/current-mc10-10-source-build/packaged-resources/MANIFEST.MF whitespace=cr-at-eol,-blank-at-eof

# Keep diagnostic source pins byte-exact, including the MC source archive.
workstreams/queued-centre-action-observation/** -text
workstreams/queued-centre-action-observation/source.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

workstreams/native-home-current-spawn/** -text

workstreams/saved-home-shutdown-anchor/** -text

workstreams/consumed-wm-cursor-warp/** -text

workstreams/configurable-mc-window/** -text
