{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"palcraft:travel/v1",
 "title":"PalCraft authority travel events",
 "type":"object",
 "required":["t","v","phase","tx","player","pal_uid","session_id","session_generation","mc_epoch","world_session","world_id","server_session_id","dim","view"],
 "properties":{
  "t":{"const":"travel"},"v":{"const":1},
  "phase":{"enum":["prepare","committed","complete","error","recovery_required","client_ready","client_observed","client_abort","rebase_required"]},
  "tx":{"type":"string","minLength":1,"maxLength":512},
  "player":{"$ref":"#/$defs/uuid"},"pal_uid":{"$ref":"#/$defs/uuid"},"session_id":{"$ref":"#/$defs/uuid"},
  "session_generation":{"type":"integer","minimum":1},"mc_epoch":{"type":"string","minLength":1},
  "world_session":{"type":"string","minLength":1},"world_id":{"type":"string","minLength":1},"server_session_id":{"type":"string","minLength":1},
  "dim":{"enum":["minecraft:overworld","minecraft:the_nether","minecraft:the_end"]},"view":{"type":"integer","minimum":1},
  "mapping":{"$ref":"#/$defs/mapping"},"required_bounds":{"$ref":"#/$defs/bounds"},"pos":{"$ref":"#/$defs/mcVector"},
  "yaw":{"type":"number"},"pitch":{"type":"number"},"target_pawn":{"$ref":"#/$defs/ueVector"},
  "position":{"$ref":"#/$defs/ueVector"},"region_id":{"type":"string","minLength":1},
  "applied":{"type":"boolean"},"authority_source":{"const":"pal_server"},"operation":{"const":"world_view_ack"},
  "error":{"type":"string"},"needs_mc_rollback":{"type":"boolean"},"recovering":{"type":"boolean"}
 },
 "allOf":[
  {"if":{"properties":{"phase":{"const":"prepare"}}},"then":{"required":["mapping","required_bounds","pos","yaw","pitch","target_pawn"]}},
  {"if":{"properties":{"phase":{"const":"committed"}}},"then":{"required":["mapping","target_pawn"]}},
  {"if":{"properties":{"phase":{"const":"complete"}}},"then":{"required":["mapping","proof","applied","authority_source","operation"],"properties":{"applied":{"const":true},"proof":{"$ref":"#/$defs/authorityProof"}}}},
  {"if":{"properties":{"phase":{"const":"client_ready"}}},"then":{"required":["proof"],"properties":{"proof":{"$ref":"#/$defs/readiness"}}}},
  {"if":{"properties":{"phase":{"const":"client_observed"}}},"then":{"required":["proof","position","region_id"],"properties":{"proof":{"$ref":"#/$defs/readiness"}}}},
  {"if":{"properties":{"phase":{"const":"client_abort"}}},"then":{"required":["error"]}}
 ],
 "$defs":{
  "uuid":{"type":"string","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
  "ueVector":{"type":"object","required":["X","Y","Z"],"properties":{"X":{"type":"number"},"Y":{"type":"number"},"Z":{"type":"number"}},"additionalProperties":false},
  "mcVector":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3},
  "bounds":{"type":"array","items":{"type":"number"},"minItems":6,"maxItems":6},
  "mapping":{"type":"object","required":["region_id","world_session","dim","origin","center","mc_anchor","scale","y_origin","region_bounds"],"properties":{
   "region_id":{"type":"string"},"world_session":{"type":"string"},"dim":{"type":"string"},
   "origin":{"$ref":"#/$defs/ueVector"},"center":{"$ref":"#/$defs/ueVector"},"mc_anchor":{"$ref":"#/$defs/mcVector"},
   "scale":{"const":100},"y_origin":{"const":64},"region_bounds":{"$ref":"#/$defs/bounds"},
   "page_size":{"type":"integer","minimum":1},"window_size":{"type":"integer","minimum":1},"slot":{"type":"integer","minimum":0},"profile":{"type":"string"}
  }},
  "readiness":{"type":"object","required":["ready","world_session","dim","view","region_id","generation","coverage_complete","covered_bounds","snapshots_pending","collision_pending","visual_pending","collision_committed","visual_committed","errors","revision"],"properties":{
   "ready":{"const":true},"world_session":{"type":"string"},"dim":{"type":"string"},"view":{"type":"integer","minimum":1},"region_id":{"type":"string"},
   "generation":{"type":"integer","minimum":1},"renderer_generation":{"type":"integer","minimum":1},"session_generation":{"type":"integer","minimum":1},
   "coverage_complete":{"const":true},"covered_bounds":{"$ref":"#/$defs/bounds"},"snapshots_pending":{"const":0},"collision_pending":{"const":0},"visual_pending":{"const":0},
   "collision_committed":{"const":true},"visual_committed":{"const":true},"errors":{"oneOf":[{"type":"object","maxProperties":0},{"type":"array","maxItems":0}]},"revision":{"type":"integer","minimum":0}
  }},
  "authorityProof":{"type":"object","required":["server_position","client_position","target_pawn","server_revision","client_revision","collision_committed","visual_committed","server_settle_ms"],"properties":{
   "server_position":{"$ref":"#/$defs/ueVector"},"client_position":{"$ref":"#/$defs/ueVector"},"target_pawn":{"$ref":"#/$defs/ueVector"},
   "server_revision":{"type":"integer","minimum":0},"client_revision":{"type":"integer","minimum":0},"collision_committed":{"const":true},"visual_committed":{"const":true},
   "server_settle_ms":{"type":"number","minimum":100,"maximum":15000}
  }}
 }
}
