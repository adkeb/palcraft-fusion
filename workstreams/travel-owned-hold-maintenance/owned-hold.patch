+ -- Keep only the movement disable owned by this travel hold. Native teleport
+ -- or character setup may restore a movement mode before the final ACK.
+ function api.maintain_hold(lock)
+  thread();if not lock or not lock.disabled then return true end
+  if not live(lock.pc)or not live(lock.pawn)or not live(lock.movement)
+   or not lock.pc:HasAuthority()or not lock.pawn:HasAuthority()
+   or not same(lock.pc.Pawn,lock.pawn)or not same(lock.pawn.CharacterMovement,lock.movement)then
+   return false,'owned_travel_hold_possession_changed'
+  end
+  if lock.movement.MovementMode~=0 then
+   lock.movement:StopMovementImmediately();lock.movement:DisableMovement()
+  end
+  return true
  end
  function api.release(lock)
   thread();if not lock then return end
