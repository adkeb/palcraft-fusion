+def local_path(value: str | Path, label: str) -> Path:
+    text = str(value)
+    if not text.startswith('/') or '\\' in text or any(c in text for c in '\r\n\x00'):
+        raise ValueError(label + ' must be an absolute POSIX path')
+    return Path(text).resolve()
+
+
+def argument(values: list[str], key: str, *, property_value: bool = False) -> str:
+    if property_value:
+        prefix = '-D' + key + '='
+        matches = [value[len(prefix):] for value in values if value.startswith(prefix)]
+    else:
+        indexes = [index for index, value in enumerate(values) if value == key]
+        if any(index + 1 == len(values) for index in indexes):
+            raise ValueError('Missing preserved role argument: ' + key)
+        matches = [values[index + 1] for index in indexes]
+    if len(matches) != 1:
+        raise ValueError('Require exactly one preserved role argument: ' + key)
+    return matches[0]
+
+
+def mac_guest(identity: dict, *, remote_root: str, data_root: str | Path,
+              launch_dir: Path, mc_ws_port: int, hud_port: int,
+              mc_server_address: str, mapping: str, max_fps: int) -> tuple[dict, dict]:
+    backend = local_path(remote_root, 'Mac backend root')
+    data = local_path(data_root, 'Mac data root')
+    launch = local_path(launch_dir, 'Mac launch directory')
+    roles, hashes = {}, {}
+    for role in ('guest', 'hud'):
+        raw = (launch / (role + '.json')).read_bytes()
+        value = json.loads(raw)
+        values = value.get('arguments')
+        if (value.get('schema') != 1 or value.get('role') != role
+                or value.get('same_original_uuid') != identity['mc_uuid']
+                or not isinstance(values, list) or any(not isinstance(item, str) for item in values)):
+            raise ValueError('Mac role witness is not this enrolled MC avatar: ' + role)
+        roles[role], hashes[role] = value, hashlib.sha256(raw).hexdigest()
+    role, hud = roles['guest'], roles['hud']
+    args, hud_args = role['arguments'], hud['arguments']
+    if (argument(args, '--uuid') != identity['mc_uuid']
+            or argument(args, '--username') != identity['mc_name']):
+        raise ValueError('Mac launch UUID/name differs from the enrolled credential')
+    bridge = local_path(argument(args, 'palcraft.bridgeDir', property_value=True), 'Mac bridge')
+    run = local_path(argument(args, '--gameDir'), 'Mac guest game directory')
+    frame = local_path(argument(args, 'palcraft.frameFile', property_value=True), 'Mac frame file')
+    credential = local_path(argument(args, 'palcraft.session.credential', property_value=True), 'Mac credential target')
+    if (not run.is_relative_to(backend) or not bridge.is_relative_to(data)
+            or not frame.is_relative_to(bridge) or not credential.is_relative_to(data)):
+        raise ValueError('Mac role paths differ from the explicit backend/data roots')
+    if (local_path(role['cwd'], 'Mac guest cwd') != run
+            or local_path(hud['cwd'], 'Mac HUD cwd') != bridge
+            or local_path(role['frame_file'], 'Mac guest frame metadata') != frame
+            or local_path(hud['frame_file'], 'Mac HUD frame metadata') != frame
+            or local_path(argument(hud_args, '--frame-file'), 'Mac HUD frame argument') != frame
+            or argument(args, 'palcraft.frameName', property_value=True) != mapping):
+        raise ValueError('Mac guest/HUD paths or logical frame mapping do not agree')
+    if (argument(args, 'palcraft.sessions.mode', property_value=True) != 'strict'
+            or int(argument(args, 'passthrough.port', property_value=True)) != mc_ws_port
+            or int(argument(hud_args, '--port')) != hud_port
+            or argument(args, 'palcraft.server', property_value=True) != mc_server_address
+            or int(argument(args, 'palcraft.maxFps', property_value=True)) != max_fps):
+        raise ValueError('Assigned ports/server/FPS differ from preserved strict Mac role arguments')
+    main = 'net.fabricmc.loader.impl.launch.knot.KnotClient'
+    if args.count(main) != 1 or role.get('main') not in ('KnotClient', main):
+        raise ValueError('Expected the existing production KnotClient role')
+    index = args.index(main)
+    guest = {'mc_ws_port': mc_ws_port, 'hud_port': hud_port, 'frame_mapping': mapping,
+             'frame_file': str(frame), 'frame_transport': 'file-map', 'bridge_dir': str(bridge),
+             'run_dir': str(run), 'credential_file': str(credential), 'mc_server_address': mc_server_address,
+             'mc_server_port': int(mc_server_address.rpartition(':')[2]), 'max_fps': max_fps,
+             'jvm_args': args[:index], 'main_class': main, 'mc_args': args[index + 1:],
+             'executable': role['executable'], 'hud_args': hud_args,
+             'launch_witness': {'directory': str(launch), 'guest_role_sha256': hashes['guest'],
+                 'hud_role_sha256': hashes['hud'], 'arguments_preserved': True,
+                 'configuration_witness_only': True, 'grants_authority': False}}
+    return guest, {'platform': 'mac-local', 'transport': 'local',
+                   'backend_root': str(backend), 'data_root': str(data)}
