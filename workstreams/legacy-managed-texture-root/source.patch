+local texture_provider,texture_provider_root
+local function texture_exists(path)local f=io.open(path,'rb');if not f then return false end;f:close();return true end
+local function texture_resource(value)
+ local namespace,name=value:match('^([a-z0-9_.%-]+):([a-z0-9_./%-]+)$')
+ assert(namespace and name,'Invalid original texture resource id')
+ for part in(name..'/'):gmatch('(.-)/')do assert(part~=''and part~='.'and part~='..','Invalid texture resource path')end
+ return namespace..'/'..name
+end
+local function legacy_texture_path(id,texture_name)
+ local resource=texture_resource(id or'minecraft:oak_planks')
+ local legacy=SHARED..'textures/'..texture_name..'.png'
+ if texture_exists(legacy)then return legacy end -- Existing legacy player packages remain valid.
+ local info=assert(models and models.status(),'Original model asset package unavailable')
+ local assets=assert(info.asset_root,'Original model asset root missing')
+ assert(assets:sub(1,#SHARED)==SHARED,'Original model asset root differs from configured bridge')
+ local namespace,name=resource:match('^([^/]+)/(.*)$')
+ local path=assets..'textures/'..namespace..'/item/'..name..'.png'
+ if texture_exists(path)then return path end
+ path=assets..'textures/'..namespace..'/block/'..name..'.png'
+ if texture_exists(path)then return path end
+ -- Stair/slab aliases use the frozen geometry provider's original texture id.
+ if name:match('_stairs$')or name:match('_slab$')then
+  if texture_provider_root~=assets then
+   local version=assert(info.geometry_version,'Original model geometry provider missing')
+   assert(version==2 or version==3,'Unsupported original geometry provider')
+   texture_provider=dofile(dir..'model_geometry_v'..version..'.lua')
+   texture_provider.configure{json=J,root=assets};texture_provider_root=assets
+  end
+  local groups=texture_provider.geometry(id,'',0,0,0)
+  for _,group in ipairs(groups or{})do
+   path=assets..'textures/'..texture_resource(group.texture)..'.png'
+   if texture_exists(path)then return path end
+  end
+ end
+ local old_fallback=SHARED..'textures/stone.png'
+ if texture_exists(old_fallback)then return old_fallback end
+ path=assets..'textures/minecraft/block/stone.png'
+ assert(texture_exists(path),'Original managed stone texture missing')
+ return path
+end
