+def with_mc_window(values, width, height):
+    result = list(values)
+    for flag, size in (('--width', width), ('--height', height)):
+        indexes = [index for index, value in enumerate(result) if value == flag]
+        if len(indexes) != 1 or indexes[0] + 1 >= len(result) or result[indexes[0] + 1].startswith('--'):
+            raise ValueError('MC window override requires one original value for ' + flag)
+        result[indexes[0] + 1] = str(size)
+    return result
