+def raw_menu_create_command(spec, profile):
+    return [str(spec['cxmenu']), '--bottle', profile['bottle_name'], '--utf8',
+        '--create', spec['menu'], '--type', 'raw', '--description', spec['description'],
+        '--command', spec['menu_command'], '--mode', 'install',
+        '--install']
+
+
+def registered_menu_command(spec):
+    """Read back only the owned menu's official native Command before launch."""
+    path = checked_path(spec['menu_registry'], spec['bottle'])
+    try:
+        data = plistlib.loads(path.read_bytes())
+    except (OSError, ValueError, plistlib.InvalidFileException) as exc:
+        raise MenuError('The vendor native menu registry is unavailable') from exc
+    matches = []
+    def visit(value):
+        if isinstance(value, dict):
+            if value.get('RawPath') == spec['menu']:
+                matches.append(value)
+            for child in value.values():
+                visit(child)
+        elif isinstance(value, list):
+            for child in value:
+                visit(child)
+    visit(data)
+    if len(matches) != 1 or matches[0].get('Command') != spec['menu_command']:
+        raise MenuError('The owned native menu Command was not installed exactly')
+    return matches[0]['Command']
 
 
